generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum UserRole {
  STUDENT
  UNIVERSITY_ADMIN
  SUPER_ADMIN
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum InstitutionStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum VerificationMethod {
  EMAIL_DOMAIN
  STUDENT_ID
  ADMISSION_NUMBER
  ADMIN_APPROVAL
  API_INTEGRATION
}

enum GroupType {
  ACADEMIC
  SOCIAL
  SPORTS
  PROFESSIONAL
  RELIGIOUS
  CULTURAL
  HOBBY
  OTHER
}

enum GroupMemberRole {
  OWNER
  MODERATOR
  MEMBER
}

enum MembershipStatus {
  PENDING
  ACTIVE
  REMOVED
  BANNED
  LEFT
}

enum PostType {
  TEXT
  IMAGE
  POLL
  QUESTION
  EVENT
  RESOURCE
  ANNOUNCEMENT
}

enum PostStatus {
  ACTIVE
  REMOVED_BY_MODERATOR
  DELETED_BY_AUTHOR
  UNDER_REVIEW
}

enum PostVisibility {
  PUBLIC
  INSTITUTION
  GROUP
  COURSE
  ORGANIZATION
}

enum ReactionType {
  LIKE
  LOVE
  INSIGHTFUL
  CELEBRATE
  CURIOUS
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  COMPLETED
}

enum EventCategory {
  ACADEMIC
  SOCIAL
  SPORTS
  CAREER
  TECHNOLOGY
  CULTURAL
  RELIGIOUS
  PROFESSIONAL
  OTHER
}

enum EventVisibility {
  PUBLIC
  INSTITUTION
  GROUP
  ORGANIZATION
}

enum AttendanceStatus {
  REGISTERED
  INTERESTED
  ATTENDED
  CANCELLED
}

enum ConversationType {
  DIRECT
  GROUP
}

enum MessageType {
  TEXT
  IMAGE
  FILE
  SYSTEM
}

enum NotificationType {
  LIKE
  COMMENT
  REPLY
  MENTION
  GROUP_INVITE
  GROUP_ANNOUNCEMENT
  EVENT_REMINDER
  NEW_MESSAGE
  COURSE_ANNOUNCEMENT
  UNIVERSITY_ANNOUNCEMENT
  OPPORTUNITY_ALERT
  VERIFICATION_UPDATE
  FOLLOW
  ANSWER_MARKED_HELPFUL
}

enum ResourceType {
  PDF
  DOCUMENT
  LINK
  IMAGE
  VIDEO_LINK
  OTHER
}

enum OpportunityCategory {
  INTERNSHIP
  SCHOLARSHIP
  HACKATHON
  FELLOWSHIP
  COMPETITION
  JOB
  VOLUNTEER
  RESEARCH
}

enum OpportunityStatus {
  ACTIVE
  EXPIRED
  CLOSED
}

enum ReportReason {
  SPAM
  HARASSMENT
  IMPERSONATION
  HATE_ABUSIVE
  FRAUD_SCAM
  INAPPROPRIATE
  OTHER
}

enum ReportStatus {
  PENDING
  REVIEWING
  RESOLVED
  DISMISSED
}

enum ReportTargetType {
  POST
  COMMENT
  USER
  GROUP
  EVENT
  MESSAGE
  RESOURCE
}

enum CalendarItemType {
  EVENT
  ASSIGNMENT
  EXAM
  CLASS
  CLUB_ACTIVITY
  PERSONAL
  REMINDER
}

enum OrganizationStatus {
  PENDING_VERIFICATION
  VERIFIED
  SUSPENDED
}

enum AnnouncementVisibility {
  INSTITUTION
  FACULTY
  DEPARTMENT
  COURSE
}

// ============================================================
// INSTITUTIONS (Multi-tenant root entity)
// ============================================================

model Institution {
  id                  String             @id @default(cuid())
  name                String
  slug                String             @unique
  shortName           String?
  description         String?
  logoUrl             String?
  coverImageUrl       String?
  websiteUrl          String?
  country             String
  city                String?
  address             String?
  email               String?
  phone               String?
  status              InstitutionStatus  @default(ACTIVE)
  /// How students prove they belong to this institution
  verificationMethod  VerificationMethod @default(ADMIN_APPROVAL)
  /// For EMAIL_DOMAIN verification method
  allowedEmailDomains String[]           @default([])
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  // Relations
  faculties           Faculty[]
  users               User[]
  groups              Group[]
  organizations       Organization[]
  events              Event[]
  announcements       Announcement[]
  opportunities       Opportunity[]
  courses             Course[]

  @@index([slug])
  @@index([status])
  @@map("institutions")
}

// ============================================================
// USERS
// ============================================================

model User {
  id                   String             @id @default(cuid())
  email                String
  passwordHash         String
  role                 UserRole           @default(STUDENT)
  verificationStatus   VerificationStatus @default(UNVERIFIED)
  isEmailVerified      Boolean            @default(false)
  isActive             Boolean            @default(true)
  isDeactivated        Boolean            @default(false)
  deactivatedAt        DateTime?
  institutionId        String
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  lastActiveAt         DateTime?

  // Relations
  institution          Institution        @relation(fields: [institutionId], references: [id])
  profile              Profile?
  sessions             Session[]
  refreshTokens        RefreshToken[]
  posts                Post[]
  comments             Comment[]
  reactions            Reaction[]
  bookmarks            Bookmark[]
  groupMemberships     GroupMember[]
  orgMemberships       OrganizationMember[]
  courseEnrollments    CourseEnrollment[]
  eventAttendances     EventAttendee[]
  sentMessages         Message[]          @relation("MessageSender")
  conversationMembers  ConversationMember[]
  notifications        Notification[]     @relation("NotificationRecipient")
  triggeredNotifs      Notification[]     @relation("NotificationActor")
  resources            Resource[]
  questions            Question[]
  answers              Answer[]
  calendarItems        CalendarItem[]
  reports              Report[]           @relation("ReportedByUser")
  reportedReports      Report[]           @relation("ReportedUser")
  blockedUsers         UserBlock[]        @relation("BlockingUser")
  blockedByUsers       UserBlock[]        @relation("BlockedUser")
  emailVerifications   EmailVerification[]
  passwordResets       PasswordReset[]
  verificationRequest  VerificationRequest?
  fcmTokens            FcmToken[]
  opportunityBookmarks OpportunityBookmark[]
  questionBookmarks    QuestionBookmark[]

  @@unique([email, institutionId])
  @@index([institutionId])
  @@index([institutionId, verificationStatus])
  @@index([institutionId, role])
  @@index([createdAt])
  @@map("users")
}

model Profile {
  id            String     @id @default(cuid())
  userId        String     @unique
  firstName     String
  lastName      String
  displayName   String?
  avatarUrl     String?
  coverImageUrl String?
  bio           String?
  dateOfBirth   DateTime?
  gender        String?
  phone         String?
  website       String?
  location      String?
  interests     String[]   @default([])
  skills        String[]   @default([])

  // Academic information
  facultyId     String?
  departmentId  String?
  programmeId   String?
  /// Academic level: 100, 200, 300, 400, etc.
  level         Int?
  studentId     String?
  admissionNo   String?
  matricNo      String?
  graduationYear Int?
  reputationPoints Int     @default(0)

  // Privacy controls
  showEmail     Boolean    @default(false)
  showPhone     Boolean    @default(false)
  showDOB       Boolean    @default(false)

  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  faculty       Faculty?   @relation(fields: [facultyId], references: [id])
  department    Department? @relation(fields: [departmentId], references: [id])
  programme     Programme? @relation(fields: [programmeId], references: [id])

  @@index([facultyId])
  @@index([departmentId])
  @@index([programmeId])
  @@map("profiles")
}

// ============================================================
// ACADEMIC STRUCTURE
// University → Faculty → Department → Programme → Course
// ============================================================

model Faculty {
  id            String       @id @default(cuid())
  institutionId String
  name          String
  shortName     String?
  description   String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  institution   Institution  @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  departments   Department[]
  profiles      Profile[]
  announcements Announcement[]

  @@unique([institutionId, name])
  @@index([institutionId])
  @@map("faculties")
}

model Department {
  id            String      @id @default(cuid())
  facultyId     String
  institutionId String
  name          String
  shortName     String?
  description   String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  faculty       Faculty     @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  programmes    Programme[]
  profiles      Profile[]
  announcements Announcement[]

  @@unique([facultyId, name])
  @@index([facultyId])
  @@index([institutionId])
  @@map("departments")
}

model Programme {
  id            String     @id @default(cuid())
  departmentId  String
  institutionId String
  name          String
  shortName     String?
  description   String?
  durationYears Int        @default(4)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  department    Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  courses       Course[]
  profiles      Profile[]

  @@unique([departmentId, name])
  @@index([departmentId])
  @@index([institutionId])
  @@map("programmes")
}

model Course {
  id            String    @id @default(cuid())
  institutionId String
  programmeId   String?
  name          String
  /// e.g., "CSC 301"
  code          String
  description   String?
  units         Int       @default(3)
  /// Academic level the course belongs to: 100, 200, 300, 400
  level         Int?
  /// Semester: 1 or 2
  semester      Int?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  institution   Institution  @relation(fields: [institutionId], references: [id])
  programme     Programme?   @relation(fields: [programmeId], references: [id])
  enrollments   CourseEnrollment[]
  posts         Post[]
  resources     Resource[]
  questions     Question[]
  announcements Announcement[]
  calendarItems CalendarItem[]
  groups        Group[]
  schedules     CourseSchedule[]

  @@unique([institutionId, code])
  @@index([institutionId])
  @@index([programmeId])
  @@map("courses")
}

model CourseEnrollment {
  id        String   @id @default(cuid())
  userId    String
  courseId  String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([courseId])
  @@index([userId])
  @@map("course_enrollments")
}

model CourseSchedule {
  id           String    @id @default(cuid())
  courseId     String
  /// 1 = Monday, 2 = Tuesday, 3 = Wednesday, 4 = Thursday, 5 = Friday, 6 = Saturday, 7 = Sunday
  dayOfWeek    Int
  startTime    String
  endTime      String
  venue        String
  building     String?
  lecturerName String?
  color        String?   @default("#2563eb")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  course       Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@index([dayOfWeek])
  @@map("course_schedules")
}

// ============================================================
// AUTHENTICATION & SESSIONS
// ============================================================

model Session {
  id           String   @id @default(cuid())
  userId       String
  userAgent    String?
  ipAddress    String?
  deviceName   String?
  isActive     Boolean  @default(true)
  lastActiveAt DateTime @default(now())
  createdAt    DateTime @default(now())
  expiresAt    DateTime

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isActive])
  @@map("sessions")
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  sessionId String?
  isRevoked Boolean  @default(false)
  /// Token family for refresh token theft detection (RFC-style rotation)
  family    String
  userAgent String?
  ipAddress String?
  createdAt DateTime @default(now())
  expiresAt DateTime

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@index([family])
  @@map("refresh_tokens")
}

model EmailVerification {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verifications")
}

model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_resets")
}

model VerificationRequest {
  id            String             @id @default(cuid())
  userId        String             @unique
  method        VerificationMethod
  /// Flexible JSON payload per verification method (student ID, admission number, etc.)
  submittedData Json
  status        VerificationStatus @default(PENDING)
  reviewedBy    String?
  reviewNote    String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("verification_requests")
}

model FcmToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  /// ios | android | web
  platform  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("fcm_tokens")
}

// ============================================================
// GROUPS
// ============================================================

model Group {
  id              String    @id @default(cuid())
  institutionId   String
  name            String
  slug            String
  description     String?
  coverImageUrl   String?
  avatarUrl       String?
  type            GroupType @default(OTHER)
  courseId        String?
  isPrivate       Boolean   @default(false)
  requireApproval Boolean   @default(false)
  isVerified      Boolean   @default(false)
  /// Denormalized for performance — updated via trigger/background job
  memberCount     Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  institution     Institution      @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  course          Course?          @relation(fields: [courseId], references: [id])
  members         GroupMember[]
  posts           Post[]
  events          Event[]
  resources       Resource[]
  announcements   Announcement[]

  @@unique([institutionId, slug])
  @@index([institutionId])
  @@index([institutionId, type])
  @@index([institutionId, courseId])
  @@map("groups")
}

model GroupMember {
  id        String           @id @default(cuid())
  groupId   String
  userId    String
  role      GroupMemberRole  @default(MEMBER)
  status    MembershipStatus @default(ACTIVE)
  joinedAt  DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  group     Group            @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([groupId])
  @@index([userId])
  @@index([groupId, status])
  @@map("group_members")
}

// ============================================================
// ORGANIZATIONS (Clubs & Official Bodies)
// ============================================================

model Organization {
  id              String             @id @default(cuid())
  institutionId   String
  name            String
  slug            String
  description     String?
  coverImageUrl   String?
  avatarUrl       String?
  websiteUrl      String?
  email           String?
  category        String?
  status          OrganizationStatus @default(PENDING_VERIFICATION)
  isOfficial      Boolean            @default(false)
  memberCount     Int                @default(0)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  institution     Institution        @relation(fields: [institutionId], references: [id])
  members         OrganizationMember[]
  posts           Post[]
  events          Event[]
  resources       Resource[]
  announcements   Announcement[]

  @@unique([institutionId, slug])
  @@index([institutionId])
  @@index([institutionId, status])
  @@map("organizations")
}

model OrganizationMember {
  id             String           @id @default(cuid())
  organizationId String
  userId         String
  role           GroupMemberRole  @default(MEMBER)
  status         MembershipStatus @default(ACTIVE)
  joinedAt       DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@map("organization_members")
}

// ============================================================
// POSTS & FEED
// ============================================================

model Post {
  id             String         @id @default(cuid())
  institutionId  String
  authorId       String
  type           PostType       @default(TEXT)
  status         PostStatus     @default(ACTIVE)
  visibility     PostVisibility @default(INSTITUTION)
  content        String?
  mediaUrls      String[]       @default([])
  /// For POLL type: { options: string[], votes: Record<string, string[]> }
  pollData       Json?
  /// Cached link preview metadata
  linkPreview    Json?
  isPinned       Boolean        @default(false)

  // Context associations — a post belongs to at most one context
  groupId        String?
  courseId       String?
  organizationId String?

  // Denormalized counts (updated atomically on reaction/comment)
  reactionCount  Int            @default(0)
  commentCount   Int            @default(0)
  shareCount     Int            @default(0)

  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  editedAt       DateTime?

  author         User           @relation(fields: [authorId], references: [id])
  group          Group?         @relation(fields: [groupId], references: [id])
  course         Course?        @relation(fields: [courseId], references: [id])
  organization   Organization?  @relation(fields: [organizationId], references: [id])
  comments       Comment[]
  reactions      Reaction[]
  bookmarks      Bookmark[]
  reports        Report[]       @relation("PostReports")

  @@index([institutionId, createdAt(sort: Desc)])
  @@index([authorId, createdAt(sort: Desc)])
  @@index([groupId, createdAt(sort: Desc)])
  @@index([courseId, createdAt(sort: Desc)])
  @@index([organizationId, createdAt(sort: Desc)])
  @@index([institutionId, status])
  @@map("posts")
}

model Comment {
  id            String    @id @default(cuid())
  postId        String
  authorId      String
  /// null = top-level comment; non-null = reply to another comment
  parentId      String?
  content       String
  isEdited      Boolean   @default(false)
  isRemoved     Boolean   @default(false)
  reactionCount Int       @default(0)
  replyCount    Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  post          Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  author        User      @relation(fields: [authorId], references: [id])
  parent        Comment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies       Comment[] @relation("CommentReplies")
  reactions     Reaction[]
  reports       Report[]  @relation("CommentReports")

  @@index([postId, createdAt])
  @@index([parentId])
  @@index([authorId])
  @@map("comments")
}

model Reaction {
  id        String       @id @default(cuid())
  userId    String
  type      ReactionType @default(LIKE)
  postId    String?
  commentId String?
  answerId  String?
  questionId String?
  createdAt DateTime     @default(now())

  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post?        @relation(fields: [postId], references: [id], onDelete: Cascade)
  comment   Comment?     @relation(fields: [commentId], references: [id], onDelete: Cascade)
  answer    Answer?      @relation(fields: [answerId], references: [id], onDelete: Cascade)
  question  Question?    @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@unique([userId, commentId])
  @@unique([userId, answerId])
  @@unique([userId, questionId])
  @@index([postId])
  @@index([commentId])
  @@index([questionId])
  @@map("reactions")
}

model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([userId])
  @@map("bookmarks")
}

// ============================================================
// EVENTS
// ============================================================

model Event {
  id               String          @id @default(cuid())
  institutionId    String
  title            String
  description      String?
  coverImageUrl    String?
  location         String?
  locationUrl      String?
  startDate        DateTime
  endDate          DateTime
  /// userId or organizationId
  organizerId      String
  /// 'user' | 'organization' | 'institution'
  organizerType    String
  category         EventCategory   @default(OTHER)
  status           EventStatus     @default(DRAFT)
  visibility       EventVisibility @default(INSTITUTION)
  capacity         Int?
  requiresRegistration Boolean     @default(false)
  isOnline         Boolean         @default(false)
  onlineMeetingUrl String?

  attendeeCount    Int             @default(0)
  interestedCount  Int             @default(0)

  groupId          String?
  organizationId   String?
  courseId         String?

  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  institution      Institution     @relation(fields: [institutionId], references: [id])
  group            Group?          @relation(fields: [groupId], references: [id])
  organization     Organization?   @relation(fields: [organizationId], references: [id])
  attendees        EventAttendee[]
  calendarItems    CalendarItem[]
  reports          Report[]        @relation("EventReports")

  @@index([institutionId, startDate])
  @@index([institutionId, status])
  @@index([groupId])
  @@index([organizationId])
  @@map("events")
}

model EventAttendee {
  id        String           @id @default(cuid())
  eventId   String
  userId    String
  status    AttendanceStatus @default(INTERESTED)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  event     Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([userId])
  @@map("event_attendees")
}

// ============================================================
// CAMPUS CALENDAR
// ============================================================

model CalendarItem {
  id          String           @id @default(cuid())
  userId      String
  title       String
  description String?
  type        CalendarItemType
  startDate   DateTime
  endDate     DateTime?
  allDay      Boolean          @default(false)
  color       String?
  location    String?
  reminderAt  DateTime?

  eventId     String?
  courseId    String?

  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  event       Event?           @relation(fields: [eventId], references: [id])
  course      Course?          @relation(fields: [courseId], references: [id])

  @@index([userId, startDate])
  @@index([userId, type])
  @@map("calendar_items")
}

// ============================================================
// DIRECT MESSAGING
// ============================================================

model Conversation {
  id          String             @id @default(cuid())
  type        ConversationType   @default(DIRECT)
  name        String?
  avatarUrl   String?
  /// Cached for fast conversation list rendering
  lastMessage Json?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  members     ConversationMember[]
  messages    Message[]

  @@map("conversations")
}

model ConversationMember {
  id             String       @id @default(cuid())
  conversationId String
  userId         String
  isAdmin        Boolean      @default(false)
  lastReadAt     DateTime?
  mutedUntil     DateTime?
  joinedAt       DateTime     @default(now())
  leftAt         DateTime?

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
  @@index([conversationId])
  @@map("conversation_members")
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  type           MessageType  @default(TEXT)
  content        String?
  mediaUrl       String?
  /// Metadata for files: { fileName, fileSize, mimeType }
  metadata       Json?
  isEdited       Boolean      @default(false)
  isDeleted      Boolean      @default(false)
  /// Array of userIds who have read this message
  readBy         String[]     @default([])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation("MessageSender", fields: [senderId], references: [id])
  reports        Report[]     @relation("MessageReports")

  @@index([conversationId, createdAt])
  @@index([senderId])
  @@map("messages")
}

// ============================================================
// NOTIFICATIONS
// ============================================================

model Notification {
  id          String           @id @default(cuid())
  recipientId String
  actorId     String?
  type        NotificationType
  title       String
  body        String
  /// Extra context: { postId, groupId, eventId, etc. }
  data        Json?
  read        Boolean          @default(false)
  readAt      DateTime?
  createdAt   DateTime         @default(now())

  recipient   User             @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actor       User?            @relation("NotificationActor", fields: [actorId], references: [id])

  @@index([recipientId, read])
  @@index([recipientId, createdAt(sort: Desc)])
  @@map("notifications")
}

// ============================================================
// RESOURCES
// ============================================================

model Resource {
  id             String       @id @default(cuid())
  institutionId  String
  uploaderId     String
  title          String
  description    String?
  type           ResourceType @default(PDF)
  /// S3 object key (NOT a full URL — URLs are generated via signed URL service)
  fileKey        String
  fileName       String?
  fileSize       Int?
  mimeType       String?
  downloadCount  Int          @default(0)
  category       String?      @default("SUMMARY_NOTE")
  semester       Int?
  academicYear   Int?

  courseId       String?
  groupId        String?
  organizationId String?

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  uploader       User         @relation(fields: [uploaderId], references: [id])
  course         Course?      @relation(fields: [courseId], references: [id])
  group          Group?       @relation(fields: [groupId], references: [id])
  organization   Organization? @relation(fields: [organizationId], references: [id])

  @@index([institutionId])
  @@index([courseId])
  @@index([uploaderId])
  @@index([institutionId, category])
  @@index([institutionId, academicYear])
  @@index([institutionId, semester])
  @@map("resources")
}

// ============================================================
// ACADEMIC Q&A
// ============================================================

model Question {
  id            String             @id @default(cuid())
  institutionId String
  authorId      String
  courseId      String?
  title         String
  content       String
  tags          String[]           @default([])
  isAnonymous   Boolean            @default(false)
  isClosed      Boolean            @default(false)
  viewCount     Int                @default(0)
  answerCount   Int                @default(0)
  upvoteCount   Int                @default(0)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  author        User               @relation(fields: [authorId], references: [id])
  course        Course?            @relation(fields: [courseId], references: [id])
  answers       Answer[]
  bookmarks     QuestionBookmark[]
  reactions     Reaction[]

  @@index([institutionId])
  @@index([courseId])
  @@index([authorId])
  @@map("questions")
}

model Answer {
  id              String    @id @default(cuid())
  questionId      String
  authorId        String
  content         String
  isMarkedHelpful Boolean   @default(false)
  isAnonymous     Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  question        Question  @relation(fields: [questionId], references: [id], onDelete: Cascade)
  author          User      @relation(fields: [authorId], references: [id])
  reactions       Reaction[]

  @@index([questionId])
  @@index([authorId])
  @@map("answers")
}

model QuestionBookmark {
  id         String   @id @default(cuid())
  userId     String
  questionId String
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
  @@index([userId])
  @@map("question_bookmarks")
}

// ============================================================
// OPPORTUNITIES
// ============================================================

model Opportunity {
  id               String              @id @default(cuid())
  institutionId    String
  publisherId      String
  title            String
  description      String
  category         OpportunityCategory
  status           OpportunityStatus   @default(ACTIVE)
  organizationName String?
  location         String?
  isRemote         Boolean             @default(false)
  applicationUrl   String?
  deadline         DateTime?
  stipend          String?
  requirements     String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  institution      Institution         @relation(fields: [institutionId], references: [id])
  bookmarks        OpportunityBookmark[]

  @@index([institutionId, status])
  @@index([institutionId, category])
  @@index([deadline])
  @@map("opportunities")
}

model OpportunityBookmark {
  id            String      @id @default(cuid())
  userId        String
  opportunityId String
  createdAt     DateTime    @default(now())

  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@unique([userId, opportunityId])
  @@index([userId])
  @@map("opportunity_bookmarks")
}

// ============================================================
// ANNOUNCEMENTS
// ============================================================

model Announcement {
  id             String                 @id @default(cuid())
  institutionId  String
  authorId       String
  title          String
  content        String
  visibility     AnnouncementVisibility @default(INSTITUTION)
  isPinned       Boolean                @default(false)
  expiresAt      DateTime?

  facultyId      String?
  departmentId   String?
  courseId       String?
  groupId        String?
  organizationId String?

  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  institution    Institution            @relation(fields: [institutionId], references: [id])
  faculty        Faculty?               @relation(fields: [facultyId], references: [id])
  department     Department?            @relation(fields: [departmentId], references: [id])
  course         Course?                @relation(fields: [courseId], references: [id])
  group          Group?                 @relation(fields: [groupId], references: [id])
  organization   Organization?          @relation(fields: [organizationId], references: [id])

  @@index([institutionId, createdAt(sort: Desc)])
  @@index([institutionId, visibility])
  @@map("announcements")
}

// ============================================================
// MODERATION & SAFETY
// ============================================================

model Report {
  id           String           @id @default(cuid())
  reportedById String
  targetType   ReportTargetType
  targetId     String
  reason       ReportReason
  description  String?
  status       ReportStatus     @default(PENDING)
  reviewedBy   String?
  reviewNote   String?
  reviewedAt   DateTime?

  reportedUserId String?
  postId         String?
  commentId      String?
  eventId        String?
  messageId      String?

  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  reportedBy   User             @relation("ReportedByUser", fields: [reportedById], references: [id])
  reportedUser User?            @relation("ReportedUser", fields: [reportedUserId], references: [id])
  post         Post?            @relation("PostReports", fields: [postId], references: [id])
  comment      Comment?         @relation("CommentReports", fields: [commentId], references: [id])
  event        Event?           @relation("EventReports", fields: [eventId], references: [id])
  message      Message?         @relation("MessageReports", fields: [messageId], references: [id])

  @@index([status])
  @@index([targetType, targetId])
  @@index([reportedById])
  @@map("reports")
}

model UserBlock {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker   User     @relation("BlockingUser", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("BlockedUser", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@map("user_blocks")
}

// ============================================================
// AUDIT LOG — immutable record of critical platform actions
// ============================================================

model AuditLog {
  id            String   @id @default(cuid())
  actorId       String?
  action        String
  targetType    String?
  targetId      String?
  institutionId String?
  /// Additional context specific to each action type
  metadata      Json?
  ipAddress     String?
  createdAt     DateTime @default(now())

  @@index([actorId])
  @@index([institutionId])
  @@index([createdAt])
  @@index([action])
  @@map("audit_logs")
}
